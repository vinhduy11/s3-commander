{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "S3 Commander",
  "version": "1.0.1",
  "identifier": "dev.local.s3commander",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "S3 Commander",
        "width": 1280,
        "height": 800,
        "dragDropEnabled": true,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk1MDRFNkUzQ0E2NzQzRDcKUldUWFEyZks0K1lFbGNTQUdOTVY1eXJNQVhjM1EzZXA0dTdxenhuWFc1Ync5OWRhbXNzRUVTUTUK",
      "endpoints": [
        "https://github.com/vinhduy11/s3-commander/releases/latest/download/latest.json"
      ]
    }
  }
}
